{
  "name": "NF-e Extractor Pro",
  "short_name": "NF-e Extractor",
  "description": "Extrai os produtos de DANFEs em PDF e gera planilhas Excel prontas para estoque e Power BI, direto no aparelho.",
  "lang": "pt-BR",
  "id": "./",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#071226",
  "theme_color": "#071226",
  "categories": [
    "business",
    "productivity",
    "finance"
  ],
  "icons": [
    {
      "src": "icons/mark.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icons/maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      }
    }
  ]
}
